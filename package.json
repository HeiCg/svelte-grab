{
  "name": "svelte-grab",
  "version": "1.4.2",
  "description": "Give coding agents eyes into your Svelte app: an MCP server that lets agents snapshot, find, inspect and verify live Svelte 5 UI with component and source locations, plus Alt+Click dev tools for humans.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "devtools",
    "developer-experience",
    "mcp",
    "model-context-protocol",
    "agent",
    "coding-agent",
    "playwright",
    "claude",
    "cursor",
    "ai-coding"
  ],
  "license": "MIT",
  "author": "HeiCg",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeiCg/svelte-grab"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "node": "./dist/index.server.js",
      "default": "./dist/index.js"
    },
    "./relay": {
      "types": "./dist/relay/index.d.ts",
      "default": "./dist/relay/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    }
  },
  "bin": {
    "svelte-grab": "./dist/cli/index.js",
    "svelte-grab-mcp": "./dist/mcp/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "prepare": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "dev:demo": "npm --prefix examples/playground run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run check && npm run build && npm run test:run"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/codex-sdk": ">=0.1.0",
    "html-to-image": "^1.11.0",
    "svelte": "^5.35.1",
    "vite": ">=5.0.0",
    "ws": "^8.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    },
    "html-to-image": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^25.2.1",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-check-rs": "^0.9.5",
    "svelte-eslint-parser": "^0.43.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "zod": "^4.6.5"
  }
}
