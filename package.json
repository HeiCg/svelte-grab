{
	"name": "svelte-grab",
	"version": "1.4.2",
	"description": "Give coding agents eyes into your Svelte app: an MCP server that lets agents snapshot, find, inspect and verify live Svelte 5 UI with component and source locations, plus Alt+Click dev tools for humans.",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"devtools",
		"developer-experience",
		"mcp",
		"model-context-protocol",
		"agent",
		"coding-agent",
		"playwright",
		"claude",
		"cursor",
		"ai-coding",
		"sv-add"
	],
	"license": "MIT",
	"author": "HeiCg",
	"repository": {
		"type": "git",
		"url": "https://github.com/HeiCg/svelte-grab"
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"node": "./dist/index.server.js",
			"default": "./dist/index.js"
		},
		"./relay": {
			"types": "./dist/relay/index.d.ts",
			"default": "./dist/relay/index.js"
		},
		"./mcp": {
			"types": "./dist/mcp/index.d.ts",
			"default": "./dist/mcp/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		},
		"./sv": {
			"types": "./dist/sv/index.d.ts",
			"default": "./dist/sv/index.js"
		}
	},
	"bin": {
		"svelte-grab": "./dist/cli/index.js",
		"svelte-grab-mcp": "./dist/mcp/cli.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "svelte-package -i src/lib -o dist && npm run build:server",
		"build:server": "tsc -p tsconfig.server.json",
		"prepare": "npm run build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"dev:demo": "npm --prefix examples/playground run dev",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepublishOnly": "npm run check && npm run build && npm run test:run"
	},
	"engines": {
		"node": ">=22.12"
	},
	"sideEffects": false,
	"peerDependencies": {
		"@anthropic-ai/claude-agent-sdk": ">=0.1.0",
		"@modelcontextprotocol/sdk": "^1.26.0",
		"@openai/codex-sdk": ">=0.1.0",
		"html-to-image": "^1.11.0",
		"sv": "^1.0.0",
		"svelte": "^5.35.1",
		"vite": ">=5.0.0",
		"ws": "^8.0.0",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"@anthropic-ai/claude-agent-sdk": {
			"optional": true
		},
		"@modelcontextprotocol/sdk": {
			"optional": true
		},
		"@openai/codex-sdk": {
			"optional": true
		},
		"html-to-image": {
			"optional": true
		},
		"sv": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"ws": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^9.39.5",
		"@modelcontextprotocol/sdk": "^1.32.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.19.0",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-check-rs": "^0.11.2",
		"svelte-eslint-parser": "^1.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.11",
		"zod": "^4.6.5"
	}
}
